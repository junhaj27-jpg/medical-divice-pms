# 변수 설명용 예제입니다. .env는 자동 로드하지 않습니다.
# 필요한 항목만 실제 환경에 설정하세요. 아래 주석의 선택 항목을 빈 값으로 활성화하지 마세요.
# 운영 필수: 긴 무작위 비밀키 (실제 키를 커밋하지 마세요)
SECRET_KEY=
# 개발 모드, 허용 호스트, HTTPS 설정. 생략하면 config/settings.py 기본값 사용
# DEBUG=
# ALLOWED_HOSTS=
# SECURE_COOKIES=
# SECURE_SSL_REDIRECT=
# SECURE_HSTS_SECONDS=
# SECURE_HSTS_PRELOAD=
# DB_ENGINE: sqlite 또는 postgresql. SQLITE_PATH는 SQLite 파일 경로
# DB_ENGINE=
# SQLITE_PATH=
# PostgreSQL 접속 정보 (선택)
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
# 업로드 바이트 제한. 분석 CSV는 이 제한과 5MB 중 작은 값 사용
# MAX_UPLOAD_BYTES=
# 기존 반복 불만 탐지의 일수·건수 기준
# LOT_WINDOW_DAYS=
# LOT_THRESHOLD=
# DEVICE_WINDOW_DAYS=
# DEVICE_THRESHOLD=
# 데모 생성 명령에만 사용하는 비밀번호. 운영 자료와 분리
# DEMO_PASSWORD=
# 업무 마감 알림 일수와 시간대
# TASK_DUE_SOON_DAYS=
# TIME_ZONE=
# 외부 웹으로 제공하지 않는 증빙 저장 경로
# PRIVATE_MEDIA_ROOT=
# 서버 PDF용 한글 TTF 절대 경로. 미설정이어도 분석·CSV·브라우저 인쇄 가능
# PDF_KOREAN_FONT=
# 증빙 이미지 픽셀 제한, 신뢰된 검사 프로그램 argv JSON, timeout 초
# MAX_EVIDENCE_PIXELS=
# ANTIVIRUS_COMMAND=
# ANTIVIRUS_TIMEOUT=
# 로그인 시도 제한 횟수와 기간(초)
# LOGIN_ATTEMPT_LIMIT=
# LOGIN_WINDOW_SECONDS=
# 규정 작성·승인 역할 목록과 작성자/승인자 분리 여부
# RULE_AUTHOR_ROLES=
# RULE_APPROVER_ROLES=
# RULE_REQUIRE_SEPARATION=
# 선택형 AI: 기본 비활성. 어댑터에 네트워크 timeout 설정 필요. 기본 분석에 API 키 불필요
# RULE_AI_ENABLED=
# RULE_AI_APPROVED=
# RULE_AI_ADAPTER=

# Internal safety signals and approved AI request limits
SIGNAL_COUNT=5
SIGNAL_MINIMUM=3
SIGNAL_INCREASE_PERCENT=100
RA_AI_TIMEOUT_SECONDS=20
RA_AI_MAX_INPUT_BYTES=64000
RA_AI_MAX_OUTPUT_BYTES=16000
