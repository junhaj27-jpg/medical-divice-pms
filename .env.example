SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=sqlite
# DB_ENGINE=postgresql
DB_NAME=pms
DB_USER=pms
DB_PASSWORD=replace-me
DB_HOST=db
DB_PORT=5432
SECURE_COOKIES=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_PRELOAD=False
MAX_UPLOAD_BYTES=5242880
LOT_WINDOW_DAYS=30
LOT_THRESHOLD=3
DEVICE_WINDOW_DAYS=90
DEVICE_THRESHOLD=5
DEMO_PASSWORD=
# Additional workflow settings (no real legal deadline is supplied)
TASK_DUE_SOON_DAYS=3
TIME_ZONE=Asia/Seoul
# Keep legacy media path, but NEVER expose it through a web server/static URL.
# PRIVATE_MEDIA_ROOT=/srv/pms-private
# A Korean TrueType font is mandatory for server PDFs.
# PDF_KOREAN_FONT=C:/Windows/Fonts/malgun.ttf
# Linux example: provide a licensed Korean TTF using a private read-only mount.
PDF_KOREAN_FONT=
MAX_EVIDENCE_PIXELS=25000000
# Trusted argv JSON. ClamAV-compatible exit codes: 0 clean, 1 quarantine, else failure.
# ANTIVIRUS_COMMAND=["/usr/bin/clamscan","--no-summary"]
ANTIVIRUS_COMMAND=[]
ANTIVIRUS_TIMEOUT=60
LOGIN_ATTEMPT_LIMIT=10
LOGIN_WINDOW_SECONDS=900

# RA regulation evidence workflow (v1.7)
# No provider key or model is configured by this file.
RULE_AUTHOR_ROLES=RA_QA,ADMIN
RULE_APPROVER_ROLES=ADMIN
RULE_REQUIRE_SEPARATION=True
RULE_AI_ENABLED=False
RULE_AI_APPROVED=False
# Trusted, operator-approved Python callable. No built-in external provider is enabled.
RULE_AI_ADAPTER=
